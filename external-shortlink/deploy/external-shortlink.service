[Unit]
Description=External short-link redirect service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=external-shortlink
Group=external-shortlink
WorkingDirectory=/opt/external-shortlink
EnvironmentFile=/etc/external-shortlink.env
Environment=PROMETHEUS_MULTIPROC_DIR=/run/external-shortlink-prometheus
RuntimeDirectory=external-shortlink-prometheus
RuntimeDirectoryMode=0750
ExecStart=/opt/external-shortlink/.venv/bin/uvicorn external_shortlink.app:app --host 127.0.0.1 --port 8081 --workers 4 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-server-header
Restart=always
RestartSec=2s
TimeoutStopSec=30s
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/external-shortlink /run/external-shortlink-prometheus
UMask=0027

[Install]
WantedBy=multi-user.target
